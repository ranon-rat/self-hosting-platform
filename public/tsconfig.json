{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ES2020"],

    "rootDir": "typescript",
    "outDir": "dist",

    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["typescript/**/*"]
}
